# ─── Lokale ontwikkeling ──────────────────────────────────────────────────────
# Kopieer dit bestand naar .env en vul de waarden in.
# Railway-deployment: stel deze variabelen in via het Railway-dashboard.

# Django
DJANGO_SECRET_KEY=verander-dit-naar-een-veilige-willekeurige-sleutel
DJANGO_SETTINGS_MODULE=techture_media.settings.production
DJANGO_ALLOWED_HOSTS=jouwdomein.nl,www.jouwdomein.nl,jouwapp.up.railway.app

# Database
# Railway vult DATABASE_URL automatisch in wanneer je een PostgreSQL-service
# aan je project koppelt. Lokaal kun je de losse variabelen gebruiken.
DATABASE_URL=postgresql://gebruiker:wachtwoord@host:5432/dbnaam

# CSRF — vul je Railway-subdomain én eigen domein in (kommagescheiden)
CSRF_TRUSTED_ORIGINS=https://jouwapp.up.railway.app,https://jouwdomein.nl

# E-mail (optioneel — voor het contactformulier)
EMAIL_HOST=smtp.sendgrid.net
EMAIL_PORT=587
EMAIL_HOST_USER=apikey
EMAIL_HOST_PASSWORD=jouw-smtp-wachtwoord
DEFAULT_FROM_EMAIL=hallo@techture.media

# Wagtail
WAGTAILADMIN_BASE_URL=https://jouwdomein.nl
